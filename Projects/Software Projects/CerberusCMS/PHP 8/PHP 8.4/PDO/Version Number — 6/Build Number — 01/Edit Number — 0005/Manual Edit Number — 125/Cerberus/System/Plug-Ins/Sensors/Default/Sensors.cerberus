/*
 ============================================================================================================
 +
 +
 + Plug-In :: Sensors :: Acceleration :: Accelerometer :: H.T.M.L. 5
 +
 +
 ============================================================================================================
*/

/*
 ============================================================================================================
 +
 + Plug-In :: Sensors :: Acceleration :: Accelerometer :: H.T.M.L. 5 :: X, Y, Z
 + Accelerometer Along X, Y and Z Axis With Hyper-Text Reference
 ============================================================================================================
*/

$_GLOBAL_SYSTEM_PLUGIN_SENSORS_ACCELEROMETER_LINEAR_XYZ_HTML5_APPLICATION_PANEL	= "
<SCRIPT>
const acl			= new Accelerometer({ frequency: 60 });

	acl.addEventListener(\"reading\", () => {
		console.log(`Acceleration along the X-axis ${acl.x}`);
		console.log(`Acceleration along the Y-axis ${acl.y}`);
		console.log(`Acceleration along the Z-axis ${acl.z}`);

});

acl.start();
</SCRIPT>
";

/*
 ============================================================================================================
 +
 +
 + Plug-In :: Sensors :: Acceleration :: Linear Acceleration :: H.T.M.L. 5
 +
 +
 ============================================================================================================
*/

/*
 ============================================================================================================
 +
 + Plug-In :: Acceleration :: Linear-Acceleration :: H.T.M.L. 5 :: X, Y, Z
 + Linear-Acceleration Along X, Y and Z Axis With Hyper-Text Reference
 ============================================================================================================
*/

$_GLOBAL_SYSTEM_PLUGIN_SENSORS_ACCELERATION_LINEAR_XYZ_HTML5_APPLICATION_PANEL		= "
<SCRIPT>
if ('LinearAccelerationSensor' in window && 'Gyroscope' in window) {
	document.getElementById('moApi').innerHTML = 'Generic Sensor API';
  
	let lastReadingTimestamp;
	let accelerometer = new LinearAccelerationSensor();

	accelerometer.addEventListener('reading', e => {

		if (lastReadingTimestamp) {
			intervalHandler(Math.round(accelerometer.timestamp - lastReadingTimestamp));
}

	lastReadingTimestamp = accelerometer.timestamp
	accelerationHandler(accelerometer, 'moAcceleration');
});

accelerometer.start();
</SCRIPT>
";

/*
 ============================================================================================================
 +
 +
 + Plug-In :: Sensors :: Gravity :: :: H.T.M.L. 5
 +
 +
 ============================================================================================================
*/

/*
 ============================================================================================================
 +
 + Plug-In :: Sensors :: Gravity :: H.T.M.L. 5 :: X, Y, Z
 + Gravity Along X, Y and Z Axis With Hyper-Text Reference
 ============================================================================================================
*/

$_GLOBAL_SYSTEM_PLUGIN_SENSORS_GRAVITY_XYZ_HTML5_APPLICATION_PANEL			= "
<SCRIPT>
if ('GravitySensor' in window) {
	let gravity = new GravitySensor();
	gravity.addEventListener('reading', e => accelerationHandler(gravity, 'moAccelerationGravity'));

gravity.start();

}
</SCRIPT>
";

/*
 ============================================================================================================
 +
 +
 + Plug-In :: Sensors :: Gyroscope :: :: H.T.M.L. 5
 +
 +
 ============================================================================================================
*/

/*
 ============================================================================================================
 +
 + Plug-In :: Sensors :: Gyroscope :: H.T.M.L. 5 :: X, Y, Z
 + Gyroscope Along X, Y and Z Axis With Hyper-Text Reference
 ============================================================================================================
*/

$_GLOBAL_SYSTEM_PLUGIN_SENSORS_GYROSCOPE_XYZ_HTML5_APPLICATION_PANEL			= "
<SCRIPT>
let gyroscope = new Gyroscope();
	gyroscope.addEventListener('reading', e => rotationHandler({
	alpha: gyroscope.x,
	beta: gyroscope.y,
	gamma: gyroscope.z
}));

gyroscope.start();
  
} else if ('DeviceMotionEvent' in window) {
	document.getElementById('moApi').innerHTML = 'Device Motion API';
  
var onDeviceMotion = function (eventData) {
	accelerationHandler(eventData.acceleration, 'moAcceleration');
	accelerationHandler(eventData.accelerationIncludingGravity, 'moAccelerationGravity');
	rotationHandler(eventData.rotationRate);
	intervalHandler(eventData.interval);
}
  
window.addEventListener('devicemotion', onDeviceMotion, false);
} else {
	document.getElementById('moApi').innerHTML = 'No Accelerometer & Gyroscope API available';
}

function accelerationHandler(acceleration, targetId) {
	var info, xyz = \"[X, Y, Z]\";

	info = xyz.replace(\"X\", acceleration.x && acceleration.x.toFixed(3));
	info = info.replace(\"Y\", acceleration.y && acceleration.y.toFixed(3));
	info = info.replace(\"Z\", acceleration.z && acceleration.z.toFixed(3));
	document.getElementById(targetId).innerHTML = info;
}
</SCRIPT>
";

/*
 ============================================================================================================
 +
 +
 + Plug-In :: Sensors :: Magnetometer :: :: H.T.M.L. 5
 +
 +
 ============================================================================================================
*/

/*
 ============================================================================================================
 +
 + Plug-In :: Sensors :: Magnometer :: H.T.M.L. 5 :: X, Y, Z
 + Magnetometer Along X, Y and Z Axis With Hyper-Text Reference
 ============================================================================================================
*/

$_GLOBAL_SYSTEM_PLUGIN_SENSORS_MAGNETOMETER_XYZ_HTML5_APPLICATION_PANEL			= "
<SCRIPT>
let magSensor			= new Magnetometer({ frequency: 60 });

	magSensor.addEventListener(\"reading\", (e) => {
		console.log(`Magnetic field along the X-axis ${magSensor.x}`);
		console.log(`Magnetic field along the Y-axis ${magSensor.y}`);
		console.log(`Magnetic field along the Z-axis ${magSensor.z}`);
});

magSensor.start();
</SCRIPT>
";

/*
 ============================================================================================================
 +
 +
 + Plug-In :: Sensors :: Rotation :: :: H.T.M.L. 5
 +
 +
 ============================================================================================================
*/

/*
 ============================================================================================================
 +
 + Plug-In :: Sensors :: Rotation :: H.T.M.L. 5 :: X, Y, Z
 + Rotation Along X, Y and Z Axis With Hyper-Text Reference
 ============================================================================================================
*/

$_GLOBAL_SYSTEM_PLUGIN_SENSORS_ORIENTATION_XYZ_HTML5_APPLICATION_PANEL			= "
<SCRIPT>
function rotationHandler(rotation) {
	var info, xyz = \"[X, Y, Z]\";

	info = xyz.replace(\"X\", rotation.alpha && rotation.alpha.toFixed(3));
	info = info.replace(\"Y\", rotation.beta && rotation.beta.toFixed(3));
	info = info.replace(\"Z\", rotation.gamma && rotation.gamma.toFixed(3));
	document.getElementById(\"moRotation\").innerHTML = info;
}

function intervalHandler(interval) {
	document.getElementById(\"moInterval\").innerHTML = interval;
}
</SCRIPT>
";
?>